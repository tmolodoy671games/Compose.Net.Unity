<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityProjectDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</UnityProjectDirectory>
    <UnityEditorDirectory Condition="'$(UnityEditorDirectory)' == ''">C:/Program Files/Unity/Hub/Editor/7000.0.0a12/Editor</UnityEditorDirectory>
    <UnityManagedDirectory>$(UnityEditorDirectory)/Data/Managed/UnityEngine</UnityManagedDirectory>
    <AssemblyName>Compose.Net.Unity.Animation.Kaspresso.Tests</AssemblyName>
    <ComposeRuntimeAssembly Condition="'$(ComposeRuntimeAssembly)' == ''">$(UnityProjectDirectory)/Assets/Packages/Compose.Net.Unity/Assemblies/Compose.Net.dll</ComposeRuntimeAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnityProjectDirectory)/Assets/Tests/Editor/Kaspresso/*.cs" />
    <Analyzer Include="$(UnityProjectDirectory)/Assets/Analyzers/Compose.Net.CodeGen.dll" />
    <Reference Include="Compose.Net" HintPath="$(ComposeRuntimeAssembly)" />
    <Reference Include="Compose.Net.Kaspresso" HintPath="$(UnityProjectDirectory)/Assets/Packages/Compose.Net.Unity/Assemblies/Editor/Compose.Net.Kaspresso.dll" />
    <Reference Include="Compose.Net.Unity" HintPath="$(UnityProjectDirectory)/Temp/Bin/Debug/Compose.Net.Unity/Compose.Net.Unity.dll" />
    <Reference Include="StableCollections" HintPath="$(UnityProjectDirectory)/Assets/Packages/T.Molodoy.StableCollections.0.0.45/lib/netstandard2.1/StableCollections.dll" />
    <Reference Include="Sharp Extensions" HintPath="$(UnityProjectDirectory)/Assets/Packages/T.Molodoy.SharpExtensions.0.0.48/lib/netstandard2.1/Sharp Extensions.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(UnityManagedDirectory)/UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.UIElementsModule" HintPath="$(UnityManagedDirectory)/UnityEngine.UIElementsModule.dll" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(UnityManagedDirectory)/UnityEngine.IMGUIModule.dll" />
    <Reference Include="UnityEngine.UICommonModule" HintPath="$(UnityManagedDirectory)/UnityEngine.UICommonModule.dll" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(UnityManagedDirectory)/UnityEngine.InputLegacyModule.dll" />
    <Reference Include="nunit.framework" HintPath="$(NUnitPath)" />
  </ItemGroup>
</Project>
